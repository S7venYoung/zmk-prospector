#include <behaviors.dtsi>
#include <behaviors/runtime_macro.dtsi>
#include <behaviors/runtime-sensor-rotate.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/rgb.h> // add support for RGB Underglow @20260910 by TY

// ms2 dongle has no RGB output: old RGB actions are inert &none placeholders.
//updated keymap for 7 column layout @20260910 By TY
/ {
        behaviors {
            rsr_vol: rsr_vol {
                compatible = "zmk,behavior-runtime-sensor-rotate";
                #sensor-binding-cells = <0>;
                tap-ms = <25>;
                cw-binding = <&kp C_VOL_UP>;
                ccw-binding = <&kp C_VOL_DN>;
            };
            rsr_scroll: rsr_scroll {
                compatible = "zmk,behavior-runtime-sensor-rotate";
                #sensor-binding-cells = <0>;
                tap-ms = <25>;
                cw-binding = <&msc SCRL_DOWN>;
                ccw-binding = <&msc SCRL_UP>;
            };
        };
        keymap {
                compatible = "zmk,keymap";

                default_layer {
                        display-name = "Default Layer";
// -----------------------------------------------------------------------------------------
// |  TAB |  Q  |  W  |  E  |  R  |  T  |     |   |     |  Y  |  U   |  I  |  O  |  P  | BSPC |
// | CAPS |  A  |  S  |  D  |  F  |  G  |     |   |     |  H  |  J   |  K  |  L  |  ;  |  '   |
// | SHFT |  Z  |  X  |  C  |  V  |  B  |               |  N  |  M   |  ,  |  .  |  /  | ESC  |
//                       | GUI | LWR | SPC |          | ENT | RSE  | ALT |
                        bindings = <
&kp TAB   &kp Q &kp W &kp E &kp R &kp T  &trans    &trans &kp Y &kp U  &kp I     &kp O   &kp P    &kp BSPC
&kp CAPS  &kp A &kp S &kp D &kp F &kp G  &trans    &trans &kp H &kp J  &kp K     &kp L   &kp SEMI &kp SQT
&kp LSHFT &kp Z &kp X &kp C &kp V &kp B                   &kp N &kp M  &kp COMMA &kp DOT &kp FSLH &kp ESC
                  &kp LGUI &mo 1 &kp SPACE             &kp RET &mo 2 &kp RALT
                        >;
                };
                lower_layer {
                        display-name = "Lower Layer";
// -----------------------------------------------------------------------------------------
// |  BL  |  1    |  2    |  3    |  4  |  5  |     |   |     |  6  |  7  |  8  |  9  |  0    | BSPC |
// | BTCLR| BT1   | BT2   | BT3   | BT4 | BT5 |     |   |     | LFT | DWN |  UP | RGT |       |      |
// | SHFT |RGB_TOG|RGB_EFR|RGB_EFF|     |     |               |     |     |     |     |RGB_TOG|      |
//                                | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
&bootloader &kp N1          &kp N2          &kp N3          &kp N4       &kp N5          &trans       &trans   &kp N6   &kp N7   &kp N8 &kp N9    &kp N0           &kp BSPC
&bt BT_CLR  &bt BT_SEL 0    &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3 &bt BT_SEL 4    &trans       &trans   &kp LEFT &kp DOWN &kp UP &kp RIGHT &trans           &trans
&kp LSHFT   &none &none &none &trans       &trans                                &trans   &trans   &trans &trans    &none  &trans
                                                &kp LGUI     &trans          &kp SPACE                      &kp RET  &trans   &kp RALT
                        >;
                };

                raise_layer {
                        display-name = "Raise Layer";
// -----------------------------------------------------------------------------------------
// |  TAB |  !  |  @  |  #  |  $  |  %  |     |   |     |  ^  |  &  |  *  |  (  |  )  | BSPC |
// | CTRL |     |     |     |     |     |     |   |     |  -  |  =  |  [  |  ]  |  \  |  `   |
// | SHFT |     |     |     |     |     |               |  _  |  +  |  {  |  }  | "|" |  ~   |
//                          | GUI |     | SPC |   | ENT |     | ALT |
                        bindings = <
&kp  TAB  &kp EXCL &kp AT &kp HASH &kp DLLR &kp PRCNT &trans   &trans  &kp CARET &kp AMPS  &kp ASTRK &kp LPAR &kp RPAR &kp BSPC
&kp LCTRL &trans   &trans &trans   &trans   &trans    &trans   &trans  &kp MINUS &kp EQUAL &kp LBKT  &kp RBKT &kp BSLH &kp GRAVE
&kp LSHFT &trans   &trans &trans   &trans   &trans                     &kp UNDER &kp PLUS  &kp LBRC  &kp RBRC &kp PIPE &kp TILDE
                           &kp LGUI &trans   &kp SPACE               &kp RET &trans    &kp RALT
                        >;
                };
        };
};
