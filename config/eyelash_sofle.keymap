#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 60    // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>
#include <behaviors/runtime-sensor-rotate.dtsi>

/ {
    zip_scroll_scaler: zip_scroll_scaler {
        compatible = "zmk,input-processor-scaler";
        #input-processor-cells = <2>;
        type = <INPUT_EV_REL>;
        codes = <INPUT_REL_WHEEL INPUT_REL_HWHEEL>;
        track-remainders;
    };
};

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;     // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    HR_M: HR_M {
        compatible = "zmk,behavior-hold-tap";
        label = "HR_M";
        bindings = <&kp>, <&kp>;

        #binding-cells = <2>;
        flavor = "tap-preferred";
        tapping-term-ms = <220>;
        require-prior-idle-ms = <150>;
        quick-tap-ms = <0>;
    };

    behaviors {
        scroll_encoder: scroll_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;
            tap-ms = <25>;
        };

        rsr_vol: rsr_vol {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <25>;
            cw-binding = <&kp C_VOLUME_UP>;
            ccw-binding = <&kp C_VOL_DN>;
        };

        rsr_scroll: rsr_scroll {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <25>;
            cw-binding = <&msc SCRL_DOWN>;
            ccw-binding = <&msc SCRL_UP>;
        };

        rsr_trans: rsr_trans {
            compatible = "zmk,behavior-runtime-sensor-rotate";
            #sensor-binding-cells = <0>;
            tap-ms = <0>;
        };

        td_m_pwd: td_m_pwd {
            compatible = "zmk,behavior-tap-dance";
            label = "TD_M_PWD";
            #binding-cells = <0>;

            // 1 tap: m
            // 2 taps: password + Enter
            bindings = <&kp M>, <&pwd_enter>;

            tapping-term-ms = <200>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };

        pwd_enter: pwd_enter {
            compatible = "zmk,behavior-macro";
            label = "PWD_ENTER";
            #binding-cells = <0>;

            // outputs: x y 1 9 0 0 9 1 8 8 + Enter
            bindings =
                <&kp X>, <&kp Y>,
                <&kp N1>, <&kp N9>, <&kp N0>, <&kp N0>,
                <&kp N9>, <&kp N1>, <&kp N8>, <&kp N8>,
                <&kp ENTER>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        layer_0 {
            bindings = <
&kp ESC           &kp N1                                &kp N2            &kp N3        &kp N4  &kp N5       &mmv MOVE_UP     &kp N6  &kp N7     &kp N8     &kp N9     &kp N0     &kp LEFT_BRACE
&kp TAB           &kp Q                                 &kp W             &kp E         &kp R   &kp T        &mmv MOVE_DOWN   &kp Y   &kp U      &kp I      &kp O      &kp P      &kp BACKSPACE
&kp LGUI          &kp A                                 &kp S             &kp D         &kp F   &kp G        &mmv MOVE_LEFT   &kp H   &kp J      &kp K      &kp L      &kp SEMI   &kp RET
&mt LSHFT DELETE  &kp Z                                 &kp X             &kp C         &kp V   &kp B        &mmv MOVE_RIGHT  &kp N   &kp M      &kp COMMA  &kp DOT    &kp FSLH   &mt RIGHT_SHIFT RIGHT_BRACE
&kp C_MUTE        &kp C_AC_NEXT_KEYBOARD_LAYOUT_SELECT  &kp LEFT_CONTROL  &kp LEFT_ALT  &lt 2 DEL   &kp SPACE    &mkp LCLK        &lt 1 ESC   &kp SPACE  &kp RET    &kp MINUS  &kp EQUAL
            >;

            sensor-bindings = <&rsr_vol &rsr_trans>;
            display-name = "BASE";
        };

        layer_1 {
            bindings = <
&kp GRAVE   &kp F1           &kp F2          &kp F3           &kp F4           &kp F5             &kp UP_ARROW     &kp F6           &kp F7           &kp F8      &kp F9     &kp F10           &kp BACKSLASH
&trans      &kp GRAVE        &mkp LCLK       &mkp MCLK        &mkp RCLK        &mkp MB4           &kp DOWN_ARROW   &kp PG_UP        &kp END          &kp UP      &kp HOME   &kp MINUS         &kp EQUAL
&trans      &kp N1           &kp N2          &kp N3           &kp N4           &kp N5             &kp LEFT_ARROW   &kp PG_DN        &kp LEFT         &kp DOWN    &kp RIGHT  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
&trans      &rgb_ug RGB_OFF  &rgb_ug RGB_ON  &rgb_ug RGB_EFF  &rgb_ug RGB_EFR  &rgb_ug RGB_SPI    &kp RIGHT_ARROW  &rgb_ug RGB_BRI  &rgb_ug RGB_BRD  &kp INSERT  &kp F11    &kp F12           &trans
&kp C_MUTE  &trans           &trans          &trans           &trans           &trans             &mkp LCLK        &trans           &trans           &trans      &trans     &trans
            >;

            display-name = "NAV";
            sensor-bindings = <&rsr_vol &rsr_trans>;
        };

        layer_2 {
            bindings = <
&kp TILDE  &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &mkp MB1  &kp F6  &kp F7  &kp F8      &kp F9     &kp F10      &trans
&trans     &bt BT_CLR    &bt BT_CLR_ALL  &trans        &trans        &trans          &mkp MB3  &trans  &kp END  &kp UP_ARROW     &kp HOME    &kp UNDER    &kp PLUS
&trans     &out OUT_USB  &out OUT_BLE    &trans        &trans        &kp DELETE      &mkp MB4  &trans  &kp LEFT_ARROW  &kp DOWN_ARROW      &kp RIGHT_ARROW     &kp LBRC     &kp RBRC
&trans     &sys_reset    &trans          &bootloader   &trans        &kp KP_ENTER    &mkp MB5  &trans  &td_m_pwd  &sys_reset  &soft_off  &bootloader  &trans
&trans     &trans        &trans          &trans        &trans        &trans          &mkp MB2  &trans  &trans  &trans      &trans     &trans
            >;

            display-name = "SYS";
            sensor-bindings = <&rsr_scroll &rsr_trans>;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans  &trans
            >;

            display-name = ">L3<";
            sensor-bindings = <&scroll_encoder>;
        };
    };
};
