#include <layouts/foostan/corne/position_map.dtsi>
//#include <physical_layouts.dtsi>

/ {
    layouts_foostan_corne_7col_position_map: layouts_foostan_corne_7col_position_map {
        compatible = "zmk,physical-layout-position-map";

        complete;
    };

    foostan_corne_7col_layout: foostan_corne_7col_layout {
        compatible = "zmk,physical-layout";
        display-name = "7 Column";

        keys  //                     w   h    x    y     rot    rx    ry
            = <&key_physical_attrs 100 100    0   37       0     0     0>
            , <&key_physical_attrs 100 100  100   37       0     0     0>
            , <&key_physical_attrs 100 100  200   12       0     0     0>
