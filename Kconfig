menu "Prospector display themes"
rsource "display-themes/Kconfig"
endmenu

config ZMK_KEY_STATS
    bool "Physical key press statistics"
    depends on SETTINGS
    default n
config ZMK_KEY_STATS_SAVE_DEBOUNCE_SECONDS
    int "Key statistics save debounce"
    default 30
    depends on ZMK_KEY_STATS
config ZMK_KEY_STATS_SAVE_PRESS_INTERVAL
    int "Key statistics press save interval"
    default 50
    depends on ZMK_KEY_STATS
rsource "modules/zmk-feature-runtime-macro/Kconfig"

rsource "scanner/Kconfig"

config PROSPECTOR_DYA_BOOTLOADER_ACTION
    bool "Treat Studio Bootloader selection as an immediate bootloader action"
    depends on ZMK_STUDIO && ZMK_PROSPECTOR_DYA_SETTINGS && RETENTION_BOOT_MODE
    select REBOOT
    help
      Selecting Bootloader in DYA consumes the edit and enters the local
      device bootloader after a 500ms response grace period. Key bindings,
      settings and pairing information are not erased or changed.
